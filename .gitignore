.venv/
__pycache__/
*.pyc
*.sqlite3
db.sqlite3
staticfiles/
media/
node_modules/
# Every local environment file. .env.production carries real production
# secrets and the database password — it must never reach the repository.
.env*
!.env.example

# Supabase
supabase/.temp/
supabase/.branches/

# Database exports never belong in the repository: they carry employee ID
# numbers, salaries, addresses, customer records and password hashes. Keep the
# directory itself so the tooling has somewhere to write.
backups/*
!backups/README.md
*.sql
*.dump
!core/migrations/*.sql
