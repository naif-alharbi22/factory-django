# ===== قاعدة البيانات: Supabase PostgreSQL =====
# لا تضع كلمة المرور الحقيقية في هذا الملف — إنه قالب يُرفع مع المشروع.
# انسخه إلى .env ثم أضف كلمة المرور عبر: ./scripts/set-db-password.sh
#
# DATABASE_URL        : مجمّع المعاملات (المنفذ 6543) — لتشغيل التطبيق
# DIRECT_DATABASE_URL : مجمّع الجلسات (المنفذ 5432) — للترحيلات واستيراد البيانات
#
# الصيغة:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:<PORT>/postgres
DATABASE_URL=
DIRECT_DATABASE_URL=

DB_SSL_REQUIRE=1
DB_CONN_MAX_AGE=60

# ===== إعدادات Django =====
# ولّد مفتاحاً جديداً:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# عند التشغيل خلف HTTPS:
# DJANGO_BEHIND_PROXY=1
# DJANGO_SECURE_COOKIES=1
# DJANGO_CSRF_TRUSTED=https://factory.example.com

# ===== التشغيل =====
WEB_PORT=8000
TZ=Asia/Riyadh
RUN_MIGRATIONS=1
APP_TITLE=نظام إدارة تكاليف المشاريع
