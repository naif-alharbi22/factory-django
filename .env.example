# ===== PostgreSQL database (required) =====
# The database runs as the `db` service in compose.prod.yml, on the same host.
# Connection details are read from this file (or from real environment
# variables, which win over it). There is no silent SQLite fallback: if these
# are missing, the app refuses to start with a clear message.

# Credentials for the db container. POSTGRES_PASSWORD has no default on
# purpose — compose refuses to start without it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=

# How the app reaches it. "db" is the service name on the internal compose
# network, so this host name only resolves inside the stack. The password must
# match POSTGRES_PASSWORD above, percent-encoded if it contains @ : / or #.
DATABASE_URL=postgresql://factory:PASSWORD@db:5432/factory

# Migrations and imports use the same connection here — there is no separate
# pooler port to route around, as there was on Supabase.
DIRECT_DATABASE_URL=

# 0 for the local db service: the connection never leaves the host, and the
# postgres image ships without a TLS certificate, so requiring SSL would only
# break startup. Set to 1 for any database reached over a network.
DB_SSL_REQUIRE=0
DB_CONN_MAX_AGE=60

# ===== Migrating off Supabase (one-off) =====
# Only needed while moving the data across; scripts/migrate_from_supabase.sh
# reads this, and nothing else does. Clear it once the move is done.
# Supabase -> Project Settings -> Database -> Connection string (session mode,
# port 5432 — the transaction pooler on 6543 cannot serve pg_dump).
SUPABASE_DUMP_URL=

# ===== Local SQLite (development and tests only) =====
# USE_SQLITE=1 runs against a local file instead of PostgreSQL. Tests already
# switch to SQLite on their own; set USE_SQLITE=0 to run them against Postgres.
# USE_SQLITE=1
SQLITE_PATH=

# ===== Django =====
# Generate a key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0

# ===== Allowed domains =====
# Comma-separated list of hostnames this app will answer to.
# Any host not listed here gets HTTP 400.
#
#   DJANGO_ALLOWED_HOSTS=example.com,www.example.com,203.0.113.10
#
# Notes:
#   - Spaces after commas are fine: "example.com, www.example.com"
#   - A leading dot matches all subdomains: ".example.com" covers
#     app.example.com and api.example.com (and the apex itself)
#   - Use the hostname only — no scheme, no port, no trailing slash
#   - "*" allows any host: convenient locally, not recommended in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins are derived from DJANGO_ALLOWED_HOSTS automatically,
# so you normally do NOT need to set this. Set it only to override that,
# for example when the public URL differs from the internal hostname.
# Values here must include the scheme.
#   DJANGO_CSRF_TRUSTED=https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED=

# ===== Public domain and TLS =====
# The domain Caddy serves and requests a Let's Encrypt certificate for.
# It must already point at this server, and ports 80 and 443 must be open —
# the certificate is issued over port 80.
SITE_DOMAIN=

# Address for Let's Encrypt expiry notices. Optional.
ACME_EMAIL=

# Interface the app's own port is published on. Leave unset while setting
# things up, then set it to 127.0.0.1 once HTTPS works, so the application is
# reachable through Caddy only and not directly on :8000.
# WEB_BIND=127.0.0.1

# ===== HTTPS =====
# Enable both when a reverse proxy terminates TLS in front of the app — which
# is the case with the Caddy service in compose.prod.yml.
# With DJANGO_SECURE_COOKIES=1 the derived CSRF origins become https-only.
#
# Do NOT enable them while browsing over plain HTTP (for example directly on
# :8000): the session and CSRF cookies are marked Secure, the browser stops
# sending them back, and every form submission fails with a CSRF 403.
# DJANGO_BEHIND_PROXY=1
# DJANGO_SECURE_COOKIES=1

# ===== Time =====
# Timestamps are always STORED in UTC — this setting does not change that.
# It is the DISPLAY zone: what dates and times are converted to on screen,
# in PDF reports and in form defaults. Any IANA name works ("UTC",
# "Europe/London", ...); leave it empty for the Asia/Riyadh default.
DISPLAY_TIME_ZONE=Asia/Riyadh

# ===== Runtime =====
# On a server running compose.prod.yml, uncomment this so plain
# `docker compose ...` commands always target the production file. Without it
# they fall back to compose.yaml, which builds from source and knows nothing
# about the Caddy and Watchtower containers. Leave it commented out locally.
# COMPOSE_FILE=compose.prod.yml

WEB_PORT=8000
# The container's own clock, used for log timestamps only. Stored data and
# what users see are governed by DISPLAY_TIME_ZONE above, not by this.
TZ=UTC
RUN_MIGRATIONS=1
APP_TITLE=
